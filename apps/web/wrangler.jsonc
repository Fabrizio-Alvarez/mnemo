{
  // Cloudflare Workers — Mnemo (Next.js empaquetado por @opennextjs/cloudflare).
  // Build local:  pnpm --filter @mnemo/web exec opennextjs-cloudflare build
  // Deploy:       wrangler deploy (sube .open-next/worker.js + assets)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mnemo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Dominio custom: mnemo.falvarez.dev (falvarez.dev en CF Registrar).
  // El Worker sirve todo el tráfico del subdominio. El registro DNS
  // (CNAME o proxied) se crea desde el dashboard de CF o automáticamente
  // al asignar el custom domain en Workers → mnemo → Settings → Domains.
  "routes": [
    { "pattern": "mnemo.falvarez.dev", "custom_domain": true }
  ],
  // DATABASE_URL (endpoint de Neon) se setea como secret:
  //   npx wrangler secret put DATABASE_URL
}
